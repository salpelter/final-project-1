<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="desktopAndMobile" thread-count="2" parallel="tests" group-by-instances="true">
    <test name="desktop">
        <parameter name="isMobile" value="false" />
        <classes>
            <class name="ge.tbc.testautomation.tests.NearbyLocationsTest" />
            <class name="ge.tbc.testautomation.tests.OpenBranchesTest" />
            <class name="ge.tbc.testautomation.tests.CurrencyConversionTest" />
            <class name="ge.tbc.testautomation.tests.OffersTest" />
            <class name="ge.tbc.testautomation.tests.MoneyTransferFeesTest" />
        </classes>
    </test>

    <test name="mobile">
        <parameter name="isMobile" value="true" />
        <classes>
            <class name="ge.tbc.testautomation.tests.NearbyLocationsTest" />
            <class name="ge.tbc.testautomation.tests.OpenBranchesTest" />
            <class name="ge.tbc.testautomation.tests.CurrencyConversionTest" />
            <class name="ge.tbc.testautomation.tests.OffersTest" />
            <class name="ge.tbc.testautomation.tests.MoneyTransferFeesTest" />
        </classes>
    </test>
</suite>